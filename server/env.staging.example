# Staging environment — copy this to .env.staging and fill in values
# Get these from: Supabase dashboard → your STAGING project → Project Settings

# Database → URI (Session mode, port 5432)
# Format: postgresql://postgres.[ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# API → Project URL
SUPABASE_URL=https://[ref].supabase.co

# API → anon/public key
SUPABASE_ANON_KEY=

# API → service_role key (keep secret)
SUPABASE_SERVICE_ROLE_KEY=

# Keep these same as prod for staging tests
NODE_ENV=development
PORT=5001

# Razorpay — use TEST keys for staging (not live keys)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Copy remaining keys from server/.env as needed
# (JWT_SECRET, SMTP, etc.)

# ─────────────────────────────────────────────────────────────────────────
# Book A Sloth — SERVER environment template
# Copy to `server/.env` for local dev. In production these are set in the
# Render dashboard (Environment tab), NOT committed. Never commit real values.
# ─────────────────────────────────────────────────────────────────────────

# ── Core ──
NODE_ENV=development                      # set to "production" on Render
PORT=5000                                 # Render injects its own PORT; leave default locally
CLIENT_URL=http://localhost:5173          # PROD: https://yourdomain.com  (canonical origin; locks CORS)
# Extra CORS origins beyond CLIENT_URL (comma-separated). The www/apex sibling
# of every origin is auto-allowed, so list only hosts you can't derive — e.g.
# the Vercel alias.  PROD example: https://book-a-sloth.vercel.app
CLIENT_URLS=
API_URL=http://localhost:5000             # PROD: https://api.yourdomain.com

# ── Supabase (DB / Auth) ──
SUPABASE_URL=
SUPABASE_ANON_KEY=                        # public-safe key
SUPABASE_SERVICE_ROLE_KEY=                # SECRET — full DB access, server only
SUPABASE_JWT_SECRET=                      # only used by scripts/measure-me.js

# ── App secrets (generate strong random values; rotate if ever leaked) ──
SUPER_ADMIN_JWT_SECRET=                   # signs admin-panel JWTs
OAUTH_STATE_SECRET=                       # signs Google OAuth state param
GOOGLE_TOKEN_KEY=                         # encrypts stored Google refresh tokens (32-byte key)

# ── Google Calendar OAuth ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback   # PROD: https://api.yourdomain.com/...

# ── Razorpay (payments) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=                      # SECRET
RAZORPAY_WEBHOOK_SECRET=                  # SECRET — verifies payment.captured webhook

# ── Email (SMTP — primary provider) ──
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=                               # SECRET — app password, not account password

# ── Email (bulk / marketing / sales-automation — Brevo HTTP API, OFF Resend) ──
# Keeps campaigns + CRM outbound off the Resend transactional quota. Brevo over
# HTTPS (port 443) — NOT SMTP: PaaS hosts (Render) block outbound SMTP ports.
# Domain bookasloth.in must be authenticated in Brevo (SPF/DKIM) to send as aastha@.
BREVO_API_KEY=                            # SECRET — Brevo v3 API key
BREVO_FROM=aastha@bookasloth.in           # default marketing From (persona overrides per-send)

# ── Email (optional alt providers; leave blank if unused) ──
RESEND_API_KEY=
RESEND_FROM=
# Legacy — superseded by the shared sendBudget below (kept only for old references).
RESEND_DAILY_CAMPAIGN_CAP=
# ── Shared Resend send budget (services/email/sendBudget.js) ──────────────────
# ALL outreach (cold campaigns + CRM lifecycle drips + second-touch) shares this
# one daily budget, counted by sent_at. Resend free tier is 100/day; the ~15 held
# back is the retry/bounce reserve (we count sent rows, not raw attempts). CRM
# (P1/P2) draws freely; cold (P3) takes only the remainder.
RESEND_DAILY_CAP=85              # usable Resend sends/day across all outreach (of the hard 100)
COLD_DAILY_MAX=85               # cold upper bound — warm-up ramp: start ~20, raise over the first week
COLD_SEND_HOUR_IST=18          # cold blast window start (IST); set -1 to disable the window
COLD_WINDOW_END_IST=20         # cold window end (IST) — matches CRM quiet-hours end
# Bounce circuit-breaker: pause cold when the recent Resend bounce rate is too high
# (protects sender reputation from a dirty list).
COLD_BOUNCE_PAUSE_PCT=5        # pause cold above this bounce %
COLD_BOUNCE_WINDOW_H=48        # trailing window the rate is measured over
COLD_BOUNCE_MIN_SAMPLE=20      # minimum sends before the breaker can trip
AWS_REGION=
SES_FROM=

# ── Admin / alerts ──
ADMIN_ALERT_EMAIL=
SUPER_ADMIN_EMAIL=

# ── Investor pitch deck (/pitch-deck gate) ──
# PITCH_DECK_PASSCODE: shared access code investors type (unset = gate closed / 503).
# PITCH_DECK_EXPIRES_AT: ISO date after which the deck is dead for everyone (410); unset = never.
PITCH_DECK_PASSCODE=
PITCH_DECK_EXPIRES_AT=

# ── WhatsApp (AiSensy — currently disabled; leave blank) ──
AISENSY_API_URL=
AISENSY_WEBHOOK_SECRET=

# ── Sentry (server error tracking) ──
#   Leave SENTRY_DSN blank to disable entirely (local/CI no-op). When set, 5xx
#   responses + uncaught exceptions/rejections are reported. (utils/sentry.js)
SENTRY_DSN=                               # https://...@...ingest.sentry.io/... — blank = disabled
SENTRY_TRACES_SAMPLE_RATE=0               # 0 = errors only (no perf tracing)
SENTRY_RELEASE=                           # optional release tag (defaults to RENDER_GIT_COMMIT)

# ── Metrics endpoint (optional) ──
#   /metrics (Prometheus text) is 404 until METRICS_TOKEN is set (opt-in, so
#   process internals are never exposed by default). When set, scrapers must send
#   the matching bearer token or ?token=. (controllers/opsController.js)
METRICS_TOKEN=                            # blank = /metrics disabled; long random string to enable

# ── PostHog (server-side analytics; same project token as client) ──
POSTHOG_PROJECT_TOKEN=                    # phc_... — leave blank to disable server events
POSTHOG_HOST=https://us.i.posthog.com

# ── Server-side conversion fan-out (GA4 Measurement Protocol + Meta CAPI) ──
#   Reports money events server-side so conversions survive ad-blockers/ITP/cookie
#   death. Each tool is OFF until BOTH of its keys are set. (utils/trackServer.js)
GA4_MEASUREMENT_ID=                       # G-XXXXXXXXXX (same stream as client)
GA4_API_SECRET=                           # GA4 → Admin → Data Streams → MP API secret
FB_PIXEL_ID=                              # numeric Meta pixel id (same as client)
FB_CAPI_ACCESS_TOKEN=                     # Events Manager → Conversions API → access token
#   EMQ: server CAPI also sends IP/user-agent/_fbp/_fbc/external_id (hashed) for
#   Purchase/Lead/CompleteRegistration/InitiateCheckout — no extra keys needed.
FB_TEST_EVENT_CODE=                       # optional: route to Meta Test Events tab while testing
# FB_API_VERSION=v19.0                    # optional override
#   Facebook Lead Ads capture (controllers/metaLeadgenController). All three
#   required for the /api/webhooks/meta-leadgen endpoint to accept leads; until
#   then CRM Lead events match on email/phone only (no lead_id).
FB_WEBHOOK_VERIFY_TOKEN=                   # any secret string; echo-verifies the GET subscribe handshake
FB_APP_SECRET=                            # Meta App → Settings → Basic → App Secret (verifies POST signature)
FB_PAGE_ACCESS_TOKEN=                     # long-lived Page token with leads_retrieval (reads lead field_data)

# ── Rate-limit store (optional) ──
#   DEFAULT OFF = in-memory (correct for a single instance). Set RATE_LIMIT_STORE_URL
#   (a Postgres connection string) ONLY when running >1 API instance, so limiters
#   share counters + survive restarts. Requires migrations/v3.18_rate_limit_store.sql
#   and adds a DB round-trip per rate-limited request. (middleware/rateLimitStore.js)
RATE_LIMIT_STORE_URL=                     # blank = in-memory; postgresql://... to enable
RATE_LIMIT_STORE_POOL_MAX=5               # shared pool size when enabled

# ── Redis (optional; response cache today, shared by rate-limit store later) ──
#   OFF BY DEFAULT: blank REDIS_URL → every caller uses its in-process fallback
#   (unchanged local/CI/current-prod). Set an Upstash (or other) URL to enable the
#   shared response cache. rediss:// gets TLS automatically. Fail-open: a Redis
#   outage degrades to the fallback, never stalls requests. (services/redisClient.js)
REDIS_URL=                                # blank = disabled; redis:// or rediss://...

# ── Tuning (optional; sane defaults in code) ──
BADGE_EVAL_INTERVAL_MIN=
LEDGER_RECONCILE_INTERVAL_MIN=
AUTO_COMPLETE_INTERVAL_MIN=               # cron cadence for auto-completing elapsed bookings (default 15)
AUTO_COMPLETE_HOLD_MIN=                   # post-session dispute/refund buffer before completion (default 120)
AUTO_COMPLETE_CUTOFF=                     # ISO date; sessions ended before it are never auto-completed. Set to the deploy timestamp to suppress first-run backfill (default: 3 days before boot)
PERF_LOG=true                             # set "false" in prod to quiet per-request timing logs

# ── Load testing (LOCAL/STAGING ONLY — never set true in production) ──
LOAD_TEST_MODE=false                      # stubs notifications/SMTP/calendar-writes + bypasses rate limiters; fail-safe OFF in prod
LOADTEST_VENDOR_PASSWORD=LoadTest!2026    # password for seeded loadtest-* vendors
TEST_VENDOR_GOOGLE_ACCESS_TOKEN=          # optional: enables the real-FreeBusy cache-effectiveness plan
TEST_VENDOR_GOOGLE_REFRESH_TOKEN=         # optional: enables the real-FreeBusy cache-effectiveness plan

# ── Anthropic (Write with Bolt AI listing autofill). Server-side only. ──
ANTHROPIC_API_KEY=

# ── Google Search Console sync (SEO Audit Engine P1.5). Code no-ops until both are set. ──
GSC_SA_KEY=                               # service-account JSON key, one line (webmasters.readonly scope)
GSC_PROPERTY=                             # e.g. sc-domain:bookasloth.com
GSC_SYNC_INTERVAL_MIN=1440                # gsc-sync job cadence in minutes (default 24h)
GSC_INSPECT_MAX=2000                      # cap on URLs sent to URL Inspection per sync (quota-safe)

# ── Bolt support bot — feature flags (all default OFF; set "true" to enable) ──
BOT_INTENT_ENABLED=                       # zero-cost regex intent layer (topic answers + cards) before retrieval
BOT_PILLS_ENABLED=                        # suggested follow-up pills on bot answers
BOT_ROAST_ENABLED=                        # abuse gate (wordlist → Haiku judge → roast/cool-off). Required for the whole gate incl. IP block detection
BOT_THREAT_IPBLOCK_ENABLED=               # on a detected threat, ban the IP via the durable app blocklist (needs the IP-block master switch on too); also enforces existing blocks
BOT_STRIKE_MAX=                           # strikes (roast=1, threat=2) within the window before cool-off lock (default 5)
BOT_STRIKE_WINDOW_SECONDS=                # rolling window for per-IP strike counting (default 3600)
BOT_GLOBAL_MAX_PER_MIN=                   # global bot request cap across all IPs (default 300)
CLIENT_IP_HEADER=                         # edge-proxy header carrying the real client IP (e.g. cf-connecting-ip). Blank = use req.ip. Required for correct bot IP-block/rate-limit behind Cloudflare

# ── CRM touch governor — the ONE cap across every automated touch (relationship engine PR-7) ──
CRM_TOUCH_CAP=                            # max automated touches per subject per window (default 1). Counts CRM sends + birthday + milestone touches together
CRM_TOUCH_WINDOW_H=                       # the rolling window in hours (default 48). Defaults match sendGate's prior 1/48h ceiling

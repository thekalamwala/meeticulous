# ─────────────────────────────────────────────────────────────────────────
# Book A Sloth — CLIENT environment template (Vite)
# Copy to `client/.env` for local dev. In production these are set in the
# Vercel dashboard (Project Settings → Environment Variables).
#
# ⚠️  Anything prefixed VITE_ is BUNDLED INTO THE PUBLIC BROWSER BUNDLE.
#     Only put publishable / non-secret keys here. NEVER a service-role key,
#     Razorpay key SECRET, or SMTP password.
# ─────────────────────────────────────────────────────────────────────────

VITE_API_URL=http://localhost:5000        # PROD: https://api.yourdomain.com
# Vercel Edge Middleware (client/middleware.js) — permanent-username 301 redirects.
# Runtime var (NOT VITE_-prefixed, NOT a build var). API base WITHOUT the /api suffix.
# Missing/wrong/unreachable → middleware fails open (old usernames 404 in-app instead
# of 301) AND adds a ~2s hang per profile load. Point at the LIVE Render URL, not a
# not-yet-live api.* subdomain.
API_ORIGIN=http://localhost:5000          # PROD: https://book-a-sloth.onrender.com
# Canonical/OG base for SEO output + the dynamic sitemap. Defaults to https://bookasloth.com.
VITE_PUBLIC_SITE_URL=                      # PROD: https://bookasloth.com
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=                    # publishable anon key (safe in browser)
# Razorpay key_id is NOT set here — the API serves it at payment time, sourced
# from Admin → Settings → Payment (DB-backed). Nothing Razorpay in the client env.

# PostHog product analytics (public client-side project token — safe in browser)
VITE_POSTHOG_PROJECT_TOKEN=                # phc_... from PostHog → Project Settings
VITE_POSTHOG_HOST=https://us.i.posthog.com

# ── Marketing / ad analytics (loaded ONLY after the user accepts the consent
#    banner). All public, browser-safe IDs. Leave blank to disable that tool. ──
VITE_GA4_MEASUREMENT_ID=                   # G-XXXXXXXXXX (GA4 → Admin → Data Streams)
VITE_FB_PIXEL_ID=                          # Meta Events Manager → Pixel ID (numeric)
VITE_CLARITY_PROJECT_ID=                   # Microsoft Clarity → Settings → project id
VITE_GTM_CONTAINER_ID=                     # GTM-XXXXXXX (Google Tag Manager → container; fires tags via the consent-gated bus)
